{
  "manifest_version": 3,
  "name": "CC98 Cleaner",
  "version": "1.0.6",
  "description": "隐藏负面风评、清零踩数，并在本地识别和过滤戾气评论。",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.cc98.org/*",
    "https://huggingface.co/*",
    "https://cdn-lfs.hf.co/*",
    "https://cdn-lfs-us-1.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.cc98.org/*"],
      "js": ["page-patch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.cc98.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CC98 Cleaner",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
